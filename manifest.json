{
  "manifest_version": 3,
  "name": "Bald Logistics — Current Tasks",
  "version": "1.0.0",
  "description": "Sync and view current tasks from portal.baldlogistics.eu",
  "action": {
    "default_title": "Current tasks"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.ts"
  },
  "permissions": ["storage", "tabs", "alarms", "scripting", "sidePanel"],
  "host_permissions": ["https://portal.baldlogistics.eu/*"],
  "content_scripts": [
    {
      "matches": ["https://portal.baldlogistics.eu/app/main/current-tasks*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
